{
    "manifest_version": 3,
    "name": "CanvasAI",
    "version": "1.0",
    "description": "AI agent extension for Canvas.",
    "action": {
        "default_popup": "index.html"
    },
    "host_permissions": [
        "https://*.instructure.com/*"
    ],
    "permissions": [
        "storage"
    ]
}